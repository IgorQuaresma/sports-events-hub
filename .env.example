# Copy to .env (used by docker compose and by the backend when run locally from backend/).
# Never commit .env — it holds secrets. All keys below are optional unless marked.

# --- backend ---
ENVIRONMENT=dev                      # dev | test | staging | prod (prod refuses default secrets)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hub
CORS_ORIGINS=["http://localhost:3000"]
RAW_DIR=data/raw
PUBLIC_WEB_URL=http://localhost:3000
# Generate real values outside dev, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_TOKEN=dev-service-token-change-me
CLICK_HASH_SALT=dev-click-salt-change-me
FETCHER_USER_AGENT=SportsEventsHubBot/0.2 (+https://github.com/IgorQuaresma/sports-events-hub)
# Contact address sent to Nominatim / Wikidata (their usage policies ask for one)
CONTACT_EMAIL=

# --- external event APIs (docs/DATA_SOURCES.md) ---
# World Triathlon: works WITHOUT a key (public mirror). A key switches to the official API.
# Register an app: https://apps-api.triathlon.org/register
WORLD_TRIATHLON_API_KEY=
# Ticketmaster Discovery API — free key at https://developer.ticketmaster.com (5000 calls/day)
TICKETMASTER_API_KEY=
# RunSignup: public race search needs no credentials; set both only if you have partner keys
RUNSIGNUP_API_KEY=
RUNSIGNUP_API_SECRET=

# --- enrichment ---
GEOCODING_ENABLED=false              # Nominatim (1 req/s, cached); set CONTACT_EMAIL when enabling
WEATHER_ENABLED=true                 # Open-Meteo race-day forecast (keyless)

# --- AI (optional): LLM query parsing, llm_page connector, Wikidata llm_fallback ---
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_EXTRACT=claude-sonnet-5-5

# --- frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
